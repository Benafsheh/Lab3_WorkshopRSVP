@model Lab3_WorkshopRSVP.Models.Rsvp

@{
    ViewData["Title"] = "Workshop Registration";
}

<h1>Workshop Registration</h1>

<p>Please fill out the form below to register.</p>

<form asp-controller="Workshops"
      asp-action="Confirm"
      method="post">

    <div class="mb-3">
        <label asp-for="FullName"
               class="form-label">Full Name</label>

        <input asp-for="FullName"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label asp-for="WorkshopTitle"
               class="form-label">Select Workshop</label>

        <select asp-for="WorkshopTitle"
                class="form-select"
                required>
            <option value="">-- Select a Workshop --</option>
            <option value="Routing Basics">Routing Basics</option>
            <option value="EF Core Intro">EF Core Intro</option>
            <option value="Razor Essentials">Razor Essentials</option>
        </select>
    </div>

    <div class="form-check mb-3">
        <input asp-for="NeedsAccommodation"
               class="form-check-input" />

        <label asp-for="NeedsAccommodation"
               class="form-check-label">
            I need accommodation
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Submit RSVP
    </button>

    <a asp-controller="Workshops"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>
